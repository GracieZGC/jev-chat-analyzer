# ============================================================
# 复制本文件为 .env 并填入你自己的密钥后使用。
# 真实 .env 已被 .gitignore 忽略，不会上传；本文件只是模板，不含任何密钥。
# ============================================================

# ---------- 分类层：Jev（Typesafe 私有接口，负责意图/情绪判定） ----------
# 这是项目默认的意图情绪分类模型。接口格式为 Typesafe 私有协议（/v1/systemone），
# 不能直接换成其他厂商的模型；若要换分类模型，需要改 server.py 里的 _jev_call 拼包逻辑。
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-latest

# ---------- 生成层：DeepSeek（负责「潜台词」+ 三条回复建议） ----------
# 这一层是 OpenAI 兼容的 /chat/completions 调用，可以换成任意 OpenAI 兼容端点：
#   OpenAI / 通义千问 / 智谱 GLM / Kimi(Moonshot) / 本地 Ollama·vLLM 等。
# 只需改下面三个变量：BASE_URL 指到对应厂商地址、MODEL 写对应模型名、API_KEY 填对应密钥。
# 前提：该端点需支持 JSON 输出模式（response_format: json_object），否则生成层会解析失败。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---------- 可选：并发度（一般不用动） ----------
GEN_MAX_WORKERS=6
JEV_MAX_WORKERS=4
